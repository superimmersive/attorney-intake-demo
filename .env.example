# Copy to .env and fill in. Never commit .env.

# Required: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# true = only route to zero-data-retention endpoints (fewer models available)
OPENROUTER_ZDR=false

# Where intake summaries go. Only these addresses ever receive the AI overview.
# Separate several with commas: a@firm.com, b@firm.com
LAWYER_EMAIL=
FIRM_NAME=Demo Law Firm

# Optional for local testing. Leave blank and emails are saved to .outbox/
# and listed at http://localhost:3000/outbox instead of being sent.
RESEND_API_KEY=
# onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=Intake Demo <onboarding@resend.dev>
